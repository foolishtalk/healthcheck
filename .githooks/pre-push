#!/bin/sh

set -eu

remote_name=$1
zero_oid=0000000000000000000000000000000000000000

block_push() {
  echo "Blocked: $1" >&2
  echo "Allowed mappings: origin main→main; private master→master." >&2
  exit 1
}

while read -r local_ref local_oid remote_ref remote_oid; do
  case "$remote_name:$local_ref:$remote_ref" in
    origin:refs/heads/main:refs/heads/main)
      ;;
    private:refs/heads/master:refs/heads/master)
      ;;
    *)
      block_push "ref $local_ref cannot be pushed to $remote_name/$remote_ref."
      ;;
  esac

  if [ "$remote_name" = "origin" ] && [ "${ALLOW_PUBLIC_SERVICES_PUSH:-}" != "1" ]; then
    if [ "$remote_oid" = "$zero_oid" ]; then
      block_push "the public main branch does not exist yet, so services.json cannot be verified."
    fi

    if ! git diff --quiet "$remote_oid" "$local_oid" -- services.json; then
      echo "Blocked: this public push changes services.json relative to origin/main." >&2
      echo "Keep real monitoring targets on private/master." >&2
      echo "For an intentional public template update, use ALLOW_PUBLIC_SERVICES_PUSH=1 git push ..." >&2
      exit 1
    fi
  fi
done
